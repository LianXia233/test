# 统一 LF。Windows 上 checkout 时不要把 .c/.h/.ino 变成 CRLF，
# 否则 lv_font_conv 生成的字体文件和 shell 脚本都会出问题。
* text=auto eol=lf

*.c            text eol=lf
*.h            text eol=lf
*.ino          text eol=lf
*.py           text eol=lf
*.js           text eol=lf
*.json         text eol=lf
*.md           text eol=lf
*.sh           text eol=lf
Makefile       text eol=lf
*.ini          text eol=lf

# 二进制
*.png          binary
*.jpg          binary
*.zip          binary
