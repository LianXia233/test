# Airpi AP3000M (MT7981B) — 风扇控制默认配置（板级层）
#
# 【层次说明】本文件叠加在 rootfs-overlay/etc/default/router-fancontrol（通用骨架）之上，
# 整体覆盖。风扇曲线对两板一致（同为被动散热 ARM 路由器级热负载）。
#
# 【与 H5000M 的关键差异 —— PWM 后端】
# AP3000M 有两款硬件版本，风扇接法不同（依据官方
# LianXia233/luci-app-airpi3000m-fancontrol）：
#   16GB eMMC → 无硬件 PWM 引脚，GPIO 540 + airpi-gpio-fan 软 PWM
#               → PWM 节点为 /sys/kernel/duty_cycle
#    8GB eMMC → 硬件 PWM，内核 pwm-fan 驱动 → hwmon pwm1（dts &fan 已使能）
# 因此这里必须用 PWM_BACKEND=auto 让运行时按 eMMC 容量选择，
# **不能**沿用 H5000M 的"只认 hwmon pwmfan"假设 —— 16GB 版上那会永远找不到节点。
#
# 由 /usr/local/sbin/router-fancontrol 读取（source 方式，等价于 OpenWrt UCI 配置）
# 修改后执行：systemctl restart router-fancontrol

BOARD_ID=ap3000m

# ---------- PWM 后端 ----------
# auto | hwmon | pwmchip | softpwm
# auto：按 /sys/block/mmcblk0/size 判定（>≈12.8GiB 走软 PWM，否则硬件 PWM），
#       与官方 airpi-fanctl 行为一致；两版硬件都能开箱可用。
PWM_BACKEND=auto

# 软 PWM 参数（仅 16GB 版生效；由 router-fancontrol-modprobe 消费）
# GPIO 540 是 AP3000M 风扇线的全局 GPIO 编号（MT7981B pinctrl 第三组起始）。
AIRPI_FAN_GPIO=540
# 模拟 PWM 周期（μs）。官方默认 15000（≈66.7Hz）：
# 周期过长易产生可闻啸叫，周期过短会增加软中断 CPU 负载。
AIRPI_FAN_PERIOD=15000
# 强制驱动：留空=自动 | softpwm | pwm（调试用，例如怀疑容量判定有误时）
AIRPI_FAN_FORCE=

# 总开关（1=启用用户空间控制，0=仅内核保护）
ENABLED=1

# 运行模式：auto（自动曲线）| manual（手动 PWM）| kernel（仅内核保护）
MODE=auto

# 曲线档位：silent | balanced | performance | custom
CURVE=balanced

# 温度来源：max（CPU/PHY/WiFi/5G 取最高）| cpu（仅 CPU）
TEMP_SOURCE=max

# 手动模式 PWM（0~255）
MANUAL_PWM=160

# 控制周期（秒，2~60）
INTERVAL=5

# 滞回（℃，降温时以 temp+HYSTERESIS 重新计算，减少风扇频繁波动，0~10）
HYSTERESIS=2

# 降速延迟（秒：请求降速时保持当前 PWM 至少这么久，0~300）
DOWN_DELAY=30

# 启动助推：风扇从停转启动时的 PWM（0~255）与保持时长（毫秒）
START_PWM=192
START_BOOST_MS=700

# 故障保护：无有效温度传感器或曲线异常时的 PWM（192~255）
FAIL_PWM=255

# 自定义曲线（格式：温度:百分比,温度:百分比，升序；0~100 表示目标 PWM 百分比）
CURVE_SILENT='20:0,35:0,40:50,55:50,70:60,85:75,95:100'
CURVE_BALANCED='20:0,35:0,40:50,55:60,70:75,85:90,95:100'
CURVE_PERFORMANCE='20:0,30:60,45:70,60:82,75:92,85:100'
CURVE_CUSTOM='20:0,40:50,55:60,70:75,85:90,95:100'
