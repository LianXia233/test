[Unit]
Description=Hiveton H5000M fan control (temperature-aware PWM policy)
Documentation=file:/usr/local/sbin/h5000m-fancontrol file:/etc/default/h5000m-fancontrol
DefaultDependencies=no
After=systemd-modules-load.service
Before=sysinit.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/h5000m-fancontrol daemon
Restart=on-failure
RestartSec=5
# PWM/thermal 输出与控制节点写失败时允许继续存活并重试
FailureAction=none

[Install]
WantedBy=sysinit.target
