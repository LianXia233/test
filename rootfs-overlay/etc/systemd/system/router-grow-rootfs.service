[Unit]
Description=Grow p5 boot-layer ext4 (delayed fallback)
Documentation=file:/usr/local/sbin/router-grow-rootfs
ConditionPathExists=!/var/lib/router-rootfs-grown

# 只由 router-grow-rootfs.timer 延迟触发，不要将本服务直接 WantedBy=multi-user.target。
# multi-user.target 会自动排在它 Wants 的单元之后；本服务若再 After=multi-user.target，
# 就会与 target 形成 ordering cycle，破坏正常启动同步点。
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/router-grow-rootfs
RemainAfterExit=yes
# 兜底超时：约束用户态卡住的情况（内核级冻结无法由 systemd 超时挽救）。
TimeoutStartSec=90
