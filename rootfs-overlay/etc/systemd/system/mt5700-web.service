[Unit]
Description=MT5700M 5G 模组管理面板 (luci-app-mt5700 移植版)
Documentation=https://github.com/LianXia233/luci-app-mt5700
After=at-webserver.service
Wants=at-webserver.service

[Service]
Type=simple
# 局域网访问：绑定 0.0.0.0:8181，LAN(br-lan) 可直达；WAN/5G 上行侧由
# nftables input 策略 drop（仅 br-lan 放行，见 rootfs-overlay/etc/nftables.conf）
ExecStart=/usr/bin/mt5700-web --bind 0.0.0.0 --port 8181 --rpc 127.0.0.1:8765 --root /usr/share/mt5700-panel/www
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
