[Unit]
Description=<board> router bring-up (WAN/LAN/bridge/Wi-Fi)
Documentation=file:/usr/local/sbin/router-init.sh
After=NetworkManager.service
Wants=NetworkManager.service
Before=router-panel.service router-panel-agent.service
# 【2026-10-09 实机串口实锤】这两项原写在 [Service] 段，systemd 直接忽略并报：
#   router-init.service:19: Unknown key 'StartLimitIntervalSec' in section [Service], ignoring.
# StartLimitBurst / StartLimitIntervalSec 属于 **[Unit]** 段。写在 [Service] 里等于没写：
# 于是注释里承诺的「失败最多重试 3 次后降级」并不成立，而 Restart=on-failure +
# RestartSec=15s 仍然生效 → 脚本持续失败时变成**每 15 秒无限重启**，与设计意图相反。
StartLimitBurst=3
StartLimitIntervalSec=600

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/router-init.sh
# 脚本把"LAN/管理面不可用"当作致命失败（非 0 退出），WAN/Wi-Fi 之类只记 warning。
# PCIe 无线与网口在开机早期可能还没枚举完，失败后 15s 重试最多 3 次通常能自愈；
# 达到上限后 systemd 停止重试（由上方 [Unit] 的 StartLimit* 约束），
# 设备仍会在降级状态（无 LAN）下继续启动，便于串口介入而不是彻底变砖。
Restart=on-failure
RestartSec=15s
# 给初始化脚本保留较宽裕的总超时上限。脚本等待有线接口最多各 30s，
# NetworkManager 激活命令单次最多等待 10s；不等待 USB WAN 或 Wi-Fi 设备，
# dnsmasq 也由 systemd 在本 oneshot 完成后启动。
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
