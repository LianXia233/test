[Unit]
# Hiveton H5000M — 系统就绪后 LED 收尾（参考官方 OpenWrt diag.sh done）
# 关闭 boot 阶段闪烁的蓝色状态灯并恢复默认 trigger（官方无默认 → 熄灭）。
Description=Hiveton H5000M LED finalize (done state)
Documentation=file:/usr/local/sbin/h5000m-led.sh
After=h5000m-led-boot.service
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/h5000m-led.sh done

[Install]
WantedBy=multi-user.target
