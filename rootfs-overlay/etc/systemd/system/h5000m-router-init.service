[Unit]
Description=Hiveton H5000M router bring-up (WAN/LAN/bridge/Wi-Fi)
Documentation=file:/usr/local/sbin/h5000m-router-init.sh
After=NetworkManager.service
Wants=NetworkManager.service
Before=router-panel.service router-panel-agent.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/h5000m-router-init.sh
# 脚本现在只把"LAN/管理面不可用"当作致命失败（非 0 退出），WAN/Wi-Fi 之类
# 只记 warning。这里据此重试：PCIe 无线与网口在开机早期可能还没枚举完，
# 失败后 15s 重试最多 3 次通常能自愈。达到上限后 systemd 停止重试，
# 设备仍会在降级状态（无 LAN）下继续启动，便于串口介入而不是彻底变砖。
Restart=on-failure
RestartSec=15s
StartLimitBurst=3
StartLimitIntervalSec=600
# 给初始化脚本保留较宽裕的总超时上限。脚本等待有线接口最多各 30s，
# NetworkManager 激活命令单次最多等待 10s；不等待 USB WAN 或 Wi-Fi 设备，
# dnsmasq 也由 systemd 在本 oneshot 完成后启动。
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
