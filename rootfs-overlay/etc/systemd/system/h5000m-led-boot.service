[Unit]
# Hiveton H5000M — boot 阶段状态 LED（参考官方 OpenWrt diag.sh preinit）
# 启动早期蓝色状态灯（led-boot）快闪 100ms/100ms；
# 内核 timer trigger 保持闪烁，oneshot 退出后仍持续。
Description=Hiveton H5000M boot LED (blue flash)
Documentation=file:/usr/local/sbin/h5000m-led.sh
DefaultDependencies=no
After=systemd-modules-load.service
Before=sysinit.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/h5000m-led.sh boot

[Install]
WantedBy=sysinit.target
