# Hiveton H5000M — 风扇控制默认配置
# 由 /usr/local/sbin/h5000m-fancontrol 读取（source 方式，等价于 OpenWrt UCI 配置）
# 修改后执行：systemctl restart h5000m-fancontrol

# 总开关（1=启用用户空间控制，0=仅内核保护）
ENABLED=1

# 运行模式：auto（自动曲线）| manual（手动 PWM）| kernel（仅内核保护）
MODE=auto

# 曲线档位：silent | balanced | performance | custom
CURVE=balanced

# 温度来源：max（CPU/PHY/WiFi/5G 取最高）| cpu（仅 CPU）
TEMP_SOURCE=max

# 手动模式 PWM（0~255）
MANUAL_PWM=160

# 控制周期（秒，2~60）
INTERVAL=5

# 滞回（℃，降温时以 temp+HYSTERESIS 重新计算，减少风扇频繁波动，0~10）
HYSTERESIS=2

# 降速延迟（秒：请求降速时保持当前 PWM 至少这么久，0~300）
DOWN_DELAY=30

# 启动助推：风扇从停转启动时的 PWM（0~255）与保持时长（毫秒）
START_PWM=192
START_BOOST_MS=700

# 故障保护：无有效温度传感器或曲线异常时的 PWM（192~255）
FAIL_PWM=255

# 自定义曲线（格式：温度:百分比,温度:百分比，升序；0~100 表示目标 PWM 百分比）
CURVE_SILENT='20:0,35:0,40:50,55:50,70:60,85:75,95:100'
CURVE_BALANCED='20:0,35:0,40:50,55:60,70:75,85:90,95:100'
CURVE_PERFORMANCE='20:0,30:60,45:70,60:82,75:92,85:100'
CURVE_CUSTOM='20:0,40:50,55:60,70:75,85:90,95:100'
