#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
#
# <board> — NetworkManager dispatcher
# WAN(eth1) DHCP 获取到 DNS 后，刷新 dnsmasq 上游并重启 dnsmasq。
# 职责归属：NM 负责 WAN 链路/DHCP；dnsmasq 负责 DNS；本脚本仅为两者之间的桥接。
# WAN DHCP 失败时保留 /run/router/upstream-resolv.conf 中的兜底 DNS，DNS 不中断。

IFACE="$1"
ACTION="$2"

[[ "$IFACE" == "eth1" ]] || exit 0
command -v nmcli >/dev/null 2>&1 || exit 0

case "$ACTION" in
  up|dhcp4-change)
    mkdir -p /run/router
    nmcli -g IP4.DNS device show "$IFACE" 2>/dev/null | sed 's/^/nameserver /' \
      > /run/router/upstream-resolv.conf.tmp
    if [[ -s /run/router/upstream-resolv.conf.tmp ]]; then
      mv /run/router/upstream-resolv.conf.tmp /run/router/upstream-resolv.conf
    else
      rm -f /run/router/upstream-resolv.conf.tmp
    fi
    systemctl try-restart dnsmasq 2>/dev/null || true
    ;;
esac
exit 0
