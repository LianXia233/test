#!/bin/sh
# <board> — p5（PARTLABEL=rootfs）引导层 ext4 扩容**兜底**脚本
#
# 布局：p5 = 引导层 ext4（引导 init + SquashFS 文件 + /overlay upper/work）。
# 固件内置的引导层镜像远小于 p5 分区（~7.24 GiB），需要扩容才能让 upper
#（/etc /var /opt 等持久化数据）有可用空间。
# **扩容目标为 4 GiB，不扩满 p5**（2026-10-09 依用户要求调整；理由见下方
# GROW_TARGET_BYTES 处注释：限制这次重量级 eMMC 写入的规模）。
#
# ============================ 2026-10-09 重要改造 ============================
# 设计原则已从「首启必跑」改为「**正常刷写不跑、只在确有必要时兜底**」：
#
# 1) 正常刷写路径（scripts/install-emmc.sh --rootfs-img）现在会在**刷写时离线扩容**
#    —— 那时 p5 未挂载、/overlay 与 loop(SquashFS) 都不存在，resize2fs 安全且可复现。
#    因此正常刷完的设备上，本脚本应当**只做一次只读容量比对就退出**，不产生任何写操作。
#
# 2) 之所以要这样改：2026-10-09 实机串口实证，系统在 t≈10s 发生静默内核级冻结
#    （CPU 0/1/3 softirq 计数冻结、CPU3 定时器停摆、NMI 取不到回栈），挂死起点与
#    本服务首次执行时刻精确重合；本项目长期跟踪的「msdc 写挂死」指向 eMMC 写路径。
#    在**运行中的根文件系统**上做全区 resize，是这台设备上最重的一次 eMMC 写操作，
#    不应发生在启动关键路径上（对应 unit 已改为 After=multi-user.target）。
#
# 3) 本脚本保留为兜底（sysupgrade 等确实只能在运行中扩容的场景），并做到：
#    - 先只读比对 fs 容量与设备容量，**已扩容则一行都不写**（只 touch marker）；
#    - 任何失败都不影响启动（恒 exit 0）；
#    - 输出可审计的日志，便于串口/journal 判断到底有没有真的动过 eMMC。
# ===========================================================================
set -u

MARKER=/var/lib/router-rootfs-grown
[ -e "$MARKER" ] && exit 0

DEV="$(findfs PARTLABEL=rootfs 2>/dev/null || true)"
[ -b "$DEV" ] || DEV=/dev/mmcblk0p5
if [ ! -b "$DEV" ]; then
    echo "router: grow skipped (no block device for PARTLABEL=rootfs)"
    exit 0
fi

if ! command -v resize2fs >/dev/null 2>&1; then
    echo "router: grow skipped (resize2fs unavailable, e2fsprogs missing?)"
    exit 0
fi

# --- 只读容量比对：设备容量（512B 扇区）vs 文件系统容量 ---
DEV_SEC="$(cat "/sys/class/block/$(basename "$DEV")/size" 2>/dev/null || echo "")"
if [ -z "$DEV_SEC" ]; then
    echo "router: grow skipped (cannot read /sys/class/block/$(basename "$DEV")/size)"
    exit 0
fi
DEV_BYTES=$((DEV_SEC * 512))

# dumpe2fs -h 是只读元数据读取，对已挂载文件系统安全。
FS_BLOCKS="$(dumpe2fs -h "$DEV" 2>/dev/null | awk -F: '/^Block count/{gsub(/ /,"",$2);print $2;exit}')"
FS_BSIZE="$(dumpe2fs -h "$DEV" 2>/dev/null | awk -F: '/^Block size/{gsub(/ /,"",$2);print $2;exit}')"
GRP_BLOCKS="$(dumpe2fs -h "$DEV" 2>/dev/null | awk -F: '/^Blocks per group/{gsub(/ /,"",$2);print $2;exit}')"

if [ -z "$FS_BLOCKS" ] || [ -z "$FS_BSIZE" ] || [ -z "$GRP_BLOCKS" ]; then
    echo "router: grow skipped (dumpe2fs could not report ext4 geometry for $DEV)"
    exit 0
fi
FS_BYTES=$((FS_BLOCKS * FS_BSIZE))
GRP_BYTES=$((GRP_BLOCKS * FS_BSIZE))
# --------------------------- 扩容目标：4 GiB（2026-10-09） ---------------------------
# 不再扩满 p5（~7.24 GiB）。原因：
#   1) resize2fs 要为新增空间写块位图 / inode 表 / 组描述符 / 备份超级块，写入量大致
#      与「新增容量」成正比。本机正在排查「msdc 写挂死」——把这次重量级写入的规模
#      从 ~7.24 GiB 压到 4 GiB，是当前最直接的降风险手段。
#   2) 4 GiB 对路由器持久化层（/etc /var /opt + 日志）已绰绰有余。
# 目标取 min(4 GiB, 设备容量)，避免在更小的分区上越界。
GROW_TARGET_BYTES=$((4096 * 1024 * 1024))
if [ "$GROW_TARGET_BYTES" -gt "$DEV_BYTES" ]; then
    GROW_TARGET_BYTES=$DEV_BYTES
fi
NEED_BYTES=$((GROW_TARGET_BYTES - FS_BYTES))

echo "router: grow check $DEV — device=${DEV_BYTES}B fs=${FS_BYTES}B target=${GROW_TARGET_BYTES}B need=${NEED_BYTES}B grp=${GRP_BYTES}B"

# 已达目标、或差额不足一个块组（resize2fs 扩到最后可能余下不足一个块组的零头，属正常）
# → **完全不调用 resize2fs**，确保正常刷写的设备上一次 eMMC 写都不产生。
if [ "$NEED_BYTES" -lt "$GRP_BYTES" ]; then
    touch "$MARKER" 2>/dev/null || true
    echo "router: already at target (need < 1 block group), nothing to do"
    exit 0
fi

# 按**块数**指定目标，避免把尺寸后缀交给 resize2fs 二次解释。
WANT_BLOCKS=$((GROW_TARGET_BYTES / FS_BSIZE))
echo "router: growing $DEV to ${GROW_TARGET_BYTES}B (${WANT_BLOCKS} blocks) by $NEED_BYTES bytes — 这是重写 eMMC 的操作；若在此处挂死，说明命中 msdc 写路径缺陷"
if resize2fs "$DEV" "$WANT_BLOCKS"; then
    touch "$MARKER" && echo "router: data layer grown: $DEV"
else
    # 失败不改启动状态：不写 marker，下次仍会重试（但不阻塞启动）。
    echo "router: resize2fs failed on $DEV (continuing, will retry next boot)"
fi
exit 0
