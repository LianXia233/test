# Airpi AP3000M (MediaTek MT7981B) Debian 13 内核配置增量片段
#
# 用法：make ARCH=arm64 defconfig
#       cat 本文件 >> .config
#       make ARCH=arm64 olddefconfig
#
# 说明：
# - 本片段在 arm64 defconfig 基础上做增量修改，缺省符号由 olddefconfig 补齐。
# - 与 h5000m-6.18.config 的差异（MT7987A → MT7981B）：
#     * PINCTRL_MT7987 / COMMON_CLK_MT7987* → PINCTRL_MT7981 / COMMON_CLK_MT7981*
#     * Wi-Fi 无 PCIe 端点：MT7981B 内置 wmac（mt7915 系列）→ MT7915E，去掉 MT7996E
#     * 无 PCIe 控制器（MT7981B 不带 PCIe）→ 去掉 PCIe 段
#     * 网口 2 口（gmac0 2.5G / gmac1 1G），无 PHY_MTK_TPHY/DP
#     * NR_CPUS=2（双核 A53）
# - 符号名以 Linux 6.18.x 为准；构建脚本会在 olddefconfig 后核验关键符号。

# ---- SoC / 平台 ----
CONFIG_ARCH_MEDIATEK=y
CONFIG_PINCTRL_MT7981=y
CONFIG_COMMON_CLK_MT7981=y
CONFIG_COMMON_CLK_MT7981_ETHSYS=y
CONFIG_ARM_MEDIATEK_CPUFREQ=y
CONFIG_MTK_PMIC_WRAP=y

# ---- 网络（Ethernet / PHY / PCS）----
CONFIG_NET_MEDIATEK_SOC=y
CONFIG_MEDIATEK_GE_PHY=y
CONFIG_REALTEK_PHY=y
# MT7981B gmac0 走 2500base-x，对端 RTL8221B 由 REALTEK_PHY 驱动；
# 无 LynxI PCS 与 TPHY 需求（这两项是 MT7987 专属）。
CONFIG_NETDEVICES=y
CONFIG_VETH=y
CONFIG_TUN=y
CONFIG_MACVLAN=y

# ---- Wi-Fi（mt76，MT7981B 内置 wmac = MT7915 IP）----
# 【为什么 CFG80211/MAC80211/mt76 必须编成模块（=m），不能内置（=y）】
# 与 H5000M 同源：内置驱动在根文件系统挂载之前就 probe，固件必然加载不到。
# MT7915 的 WA/PATCH 固件位于 /lib/firmware/mediatek/mt7981/，VFS mount root 之前不可见
# → request_firmware -ENOENT → probe 失败，且 userspace 固件回退尚未启动，无法补救。
# 改 =m 后由 udev/systemd-modules-load 在根文件系统就位后再加载。
CONFIG_RFKILL=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WLAN=y
# 上游 6.18 无 CONFIG_MT76 符号（核心为 MT76_CORE，由 MT7921E/MT7915E select 链置 y）
CONFIG_MT76_LEDS=y
CONFIG_MT7915E=m
CONFIG_WIRELESS=y
CONFIG_WIRELESS_EXT=y

# ---- eMMC / 存储 ----
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MTK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_NLS_UTF8=y
CONFIG_BLK_DEV=y

# ---- USB（MT7981B 有 1× USB3 xHCI + 1× USB2，无 DWC3）----
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_MTK=y
CONFIG_USB_STORAGE=y
CONFIG_USB_SUPPORT=y

# ---- PWM / 风扇（pwm-fan：/sys/class/hwmon/*/pwm1 控制节点 + thermal cooling device）----
CONFIG_PWM=y
CONFIG_PWM_MEDIATEK=y
# 6.18 起符号由 PWM_FAN 改名 SENSORS_PWM_FAN（drivers/hwmon/Kconfig）
CONFIG_SENSORS_PWM_FAN=y

# ---- Thermal / 电源 ----
CONFIG_THERMAL=y
CONFIG_MTK_THERMAL=y
# MT7981B 无 LVTS（低压温度传感器），温度经 efuse/thermal 简易通道，不启用 MTK_LVTS_THERMAL
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_IDLE=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# ---- 串口 / 时钟 / 杂项 ----
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_MTK=y
CONFIG_WATCHDOG=y
CONFIG_MTK_WDT=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_MT6397=y
CONFIG_GPIO_SYSFS=y
# ---------------------------------------------------------------- GPIO 软 PWM 风扇
# AP3000M 16GB eMMC 版本主板上未引出硬件 PWM 引脚，风扇由 GPIO 540 位翻转软 PWM
# 驱动（drivers/hwmon/airpi-gpio-fan，见 kernel/files-boards/ap3000m/）。
#
# 【为什么显式开启 GPIOLIB_LEGACY】
# 该驱动有两种 GPIO 申请路径，由 IS_ENABLED(CONFIG_GPIOLIB_LEGACY) 选择：
#   y → gpio_request()/gpio_free() 整数接口（长期验证的成熟路径）
#   n → descriptor + lookup table 路径（6.17 新增，依赖 gpiod_to_gpio_device 等）
# 显式置 y，避免依赖 6.18 该符号的默认值，把分支钉死在成熟路径上。
CONFIG_GPIOLIB_LEGACY=y
CONFIG_AIRPI_GPIO_FAN=m
# 8GB eMMC 版本走硬件 PWM：pwm-fan 驱动导出 hwmon pwm1，已在上方 Thermal 段
# 以 CONFIG_SENSORS_PWM_FAN=y 编进内核（避免同符号重复定义）。
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_NETDEV=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYS=y

# ---- I2C（MT7981B 有 I2C 控制器，AP3000M 板上有 RTL8221B 同总线器件）----
CONFIG_I2C=y
CONFIG_I2C_MT65XX=y
CONFIG_I2C_CHARDEV=y

# ---- NVMEM / 分区（eMMC factory 分区 → Wi-Fi EEPROM）----
CONFIG_NVMEM=y
CONFIG_NVMEM_LAYOUTS=y
CONFIG_NVMEM_LAYOUT_FIXED=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_OF_PARTITION=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
# root=PARTLABEL=rootfs 依赖 GPT 分区名解析 → 显式声明并纳入 REQUIRED_SYMBOLS 校验
CONFIG_EFI_PARTITION=y

# ---- Bridge / Netfilter / NAT（路由器必需）----
CONFIG_BRIDGE=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_FTP=y
CONFIG_NF_CONNTRACK_TFTP=y
CONFIG_NF_CONNTRACK_SIP=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_AMANDA=y
CONFIG_NF_NAT_FTP=y
CONFIG_NF_NAT_SIP=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_CT=y
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_LOG=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_QUEUE=y
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y

# ---- IPv4 / IPv6 / 路由 ----
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IPV6=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_INET=y
CONFIG_INET_DIAG=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_WIREGUARD=y

# ---- 安全 / systemd 基础 ----
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_AUTOFS_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_FW_LOADER=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_MISC=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_FUTEX=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SMP=y

# ---- 调度 / 定时器（与 H5000M 对照保持一致，避免写路径行为差异）----
CONFIG_PREEMPT_NONE=y
# CONFIG_PREEMPT is not set
CONFIG_HZ_100=y
# CONFIG_HZ_1000 is not set
# CONFIG_MQ_IOSCHED_DEADLINE is not set
# CONFIG_MQ_IOSCHED_KYBER is not set
# MT7981B 为双核 A53，NR_CPUS 收紧为 2（与 SoC 实际核数一致，消除 per-cpu 预分配差量）
CONFIG_NR_CPUS=2
CONFIG_MMC_BLOCK_MINORS=8
CONFIG_FRAME_POINTER=y
CONFIG_DMIID=n

# ---- 诊断 / 性能 ----
CONFIG_KALLSYMS=y
CONFIG_PRINTK_TIME=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_PERF_EVENTS=y
CONFIG_BPF_SYSCALL=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_PROC_KCORE=y
# ---- 挂死可诊断性（与 H5000M 对齐，勿删）----
# 背景：H5000M 实机出现过「完全静默的内核级冻结」，未启用 PSEUDO_NMI 时
#   arch_trigger_cpumask_backtrace() 走普通 IPI，关中断自旋的 CPU 不取中断 → 拿不到回栈。
#   AP3000M 沿用同一套诊断开关，避免重演「只能靠猜」的局面。
CONFIG_ARM64_PSEUDO_NMI=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=30
CONFIG_RCU_CPU_STALL_TIMEOUT=10
CONFIG_BLK_DEV_LOOP=y
CONFIG_NFS_FS=m
CONFIG_NFS_V4=m
CONFIG_CIFS=m
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_INITRAMFS_SOURCE=""

# ---- 固件加载 ----
CONFIG_FW_LOADER_USER_HELPER=n
CONFIG_EXTRA_FIRMWARE=""

# ---- WAN 拨号（PPPoE）----
CONFIG_PPP=m
CONFIG_PPPOE=m
CONFIG_PPP_ASYNC=m
CONFIG_PPP_MPPE=m

# ---- 硬件流卸载（nftables flowtable / PPE offload）----
CONFIG_NF_FLOW_TABLE=m
CONFIG_NF_FLOW_TABLE_INET=m
CONFIG_NFT_FLOW_OFFLOAD=m

# ---- 2.5G 以太网 PHY ----
# AP3000M 的 gmac0 接 RTL8221B（Realtek 2.5G），由 CONFIG_REALTEK_PHY 驱动；
# MT7981B 自带 GE PHY 走 CONFIG_MEDIATEK_GE_PHY。MEDIATEK_2P5GE_PHY 为 MediaTek
# 自家 2.5G PHY（MT7987 场景），此处不启用。
CONFIG_MTK_NET_PHYLIB=y

# ---- 5G 调制解调器（USB WWAN：MT5700M / FM350-GL 等）----
CONFIG_WWAN=m
CONFIG_MTK_T7XX=m
CONFIG_USB_NET_QMI_WWAN=m
CONFIG_USB_NET_CDC_MBIM=m
CONFIG_USB_WDM=m
CONFIG_USB_ACM=m
CONFIG_USB_SERIAL_OPTION=m
