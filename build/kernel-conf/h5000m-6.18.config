# Hiveton H5000M (MT7987A) Debian 13 内核配置增量片段
#
# 用法：make ARCH=arm64 defconfig
#       cat 本文件 >> .config
#       make ARCH=arm64 olddefconfig
#
# 说明：
# - 本片段在 arm64 defconfig 基础上做增量修改，缺省符号由 olddefconfig 补齐。
# - 符号名以 Linux 6.18.x + ImmortalWrt MT7987A 补丁为准；
#   构建脚本会在 olddefconfig 后核验关键符号，并输出报告。

# ---- SoC / 平台 ----
CONFIG_ARCH_MEDIATEK=y
CONFIG_PINCTRL_MT7987=y
CONFIG_COMMON_CLK_MT7987=y
CONFIG_COMMON_CLK_MT7987_ETHSYS=y
CONFIG_ARM_MEDIATEK_CPUFREQ=y
CONFIG_MTK_PMIC_WRAP=y

# ---- 网络（Ethernet / PHY / PCS）----
CONFIG_NET_MEDIATEK_SOC=y
CONFIG_MEDIATEK_GE_PHY=y
CONFIG_REALTEK_PHY=y
CONFIG_PCS_MTK_LYNXI=y
CONFIG_PHY_MTK_TPHY=y
CONFIG_PHY_MTK_DP=y
CONFIG_NETDEVICES=y
CONFIG_VETH=y
CONFIG_TUN=y
CONFIG_MACVLAN=y

# ---- Wi-Fi（mt76，含 MT7992）----
# 注意：CFG80211 depends on "RFKILL || !RFKILL"，tristate 逻辑下 RFKILL=m 时该条件
# 求值为 m，会把 CFG80211 上限锁死为 m（y 被静默降级，连带 MAC80211/mt76 全链降级）。
# 纯净 6.18.54 的 arch/arm64/configs/defconfig 显式写 CONFIG_RFKILL=m，是CI 应用板级
# 补丁（459 个，含 Wi-Fi/MT 补丁）后才收敛为 y。故显式声明 y，使展开结果不再依赖
# 「是否已应用板级补丁」这一环境变量——属防御性加固：CI 真实产物零差异（config diff
# 为空、Image 仅差构建时间戳），但换补丁集/换复现环境时不会静默降级成模块。
CONFIG_RFKILL=y
# 【为什么 CFG80211/MAC80211/mt76 必须编成模块（=m），不能内置（=y）】
# 2026-10-09 实机串口实锤：内置驱动在根文件系统挂载之前就 probe，固件必然加载不到。
#   时间线（实测）：PCIe 端点枚举 t=1.064s → mt7996e probe t=1.505s 请求
#   mediatek/mt7996/mt7992_rom_patch_23.bin → 而 VFS: Mounted root 在 t=1.754s。
#   固件文件此刻不可见 → -ENOENT → `mt7996e probe with driver failed with error -2`，
#   userspace 固件回退（udev/request_firmware）也尚未启动，无法补救。
#   同一个原因让 regulatory.db 也失败：`cfg80211: failed to load regulatory.db`。
#   后果是 Wi-Fi 在每一次冷启动上 100% 不可用，且与固件是否存在无关（固件打包本身正确）。
# 改 =m 后由 udev/systemd-modules-load 在根文件系统就位后再加载，固件与 regulatory.db
# 都能正常读取。RFKILL 保持 =y（内置、早可用），同时充当 CFG80211 的 tristate 解锁项。
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WLAN=y
# 上游 6.18 无 CONFIG_MT76 符号（核心为 MT76_CORE，由 MT7921E/MT7996E select 链置 y）
CONFIG_MT76_LEDS=y
CONFIG_MT7921E=m
CONFIG_MT7925E=m
CONFIG_MT7996E=m
CONFIG_WIRELESS=y
CONFIG_WIRELESS_EXT=y

# ---- eMMC / 存储 ----
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MTK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_NLS_UTF8=y
CONFIG_BLK_DEV=y

# ---- PCIe ----
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_PCIE_MEDIATEK=y
CONFIG_PCIE_MEDIATEK_GEN3=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIEAER=y
CONFIG_PCIE_PME=y
CONFIG_PCI_MSI=y

# ---- USB ----
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_MTK=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_STORAGE=y
CONFIG_USB_SUPPORT=y

# ---- PWM / 风扇（pwm-fan：/sys/class/hwmon/*/pwm1 控制节点 + thermal cooling device）----
CONFIG_PWM=y
CONFIG_PWM_MEDIATEK=y
# 6.18 起符号由 PWM_FAN 改名 SENSORS_PWM_FAN（drivers/hwmon/Kconfig）
CONFIG_SENSORS_PWM_FAN=y

# ---- Thermal / 电源 ----
CONFIG_THERMAL=y
CONFIG_MTK_LVTS_THERMAL=y
CONFIG_MTK_THERMAL=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_IDLE=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# ---- 串口 / 时钟 / 杂项 ----
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_MTK=y
CONFIG_WATCHDOG=y
CONFIG_MTK_WDT=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_MT6397=y
CONFIG_GPIO_SYSFS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_NETDEV=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYS=y

# ---- NVMEM / 分区（eMMC factory 分区 → Wi-Fi EEPROM）----
CONFIG_NVMEM=y
CONFIG_NVMEM_LAYOUTS=y
CONFIG_NVMEM_LAYOUT_FIXED=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_OF_PARTITION=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
# root=PARTLABEL=rootfs 依赖 GPT 分区名解析；此前只靠 arm64 defconfig 兜着，
# 换环境重编可能静默丢失 → 内核报 "Cannot open root device"。显式声明并纳入
# build-kernel.sh 的 REQUIRED_SYMBOLS 强制校验（与 RFKILL 事故同源的防御性加固）。
CONFIG_EFI_PARTITION=y

# ---- Bridge / Netfilter / NAT（路由器必需）----
CONFIG_BRIDGE=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_FTP=y
CONFIG_NF_CONNTRACK_TFTP=y
CONFIG_NF_CONNTRACK_SIP=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_AMANDA=y
CONFIG_NF_NAT_FTP=y
CONFIG_NF_NAT_SIP=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_CT=y
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_LOG=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_QUEUE=y
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y

# ---- IPv4 / IPv6 / 路由 ----
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IPV6=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_INET=y
CONFIG_INET_DIAG=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_WIREGUARD=y

# ---- 安全 / systemd 基础 ----
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_AUTOFS_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_FW_LOADER=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_MISC=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_FUTEX=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SMP=y
# ---- 实验 C（msdc 写挂死差异分析）对齐对照组 ----
# 可正常运行的对照组（原厂 OpenWrt 6.18.52 / ctr54188 h5000m-debian 6.12.103）
# 均为 PREEMPT_NONE + HZ_100 + 无 mq IO 调度器 + 无 BLK_INTEGRITY + 无 CMA。
# 我方此前为 arm64 defconfig 默认（PREEMPT/HZ_1000/mq-deadline），写路径行为差异最大。
# 逐项显式覆盖，防止 defconfig 基座的默认值悄悄生效：
CONFIG_PREEMPT_NONE=y
# CONFIG_PREEMPT is not set
CONFIG_HZ_100=y
# CONFIG_HZ_1000 is not set
# CONFIG_MQ_IOSCHED_DEADLINE is not set
# CONFIG_MQ_IOSCHED_KYBER is not set
# 说明：BLK_DEV_INTEGRITY 会被 defconfig 基座的 SCSI target/hisi_sas 强制 select，
# 但 eMMC 块设备从不注册 integrity profile，对写路径无功能影响，接受该差量。
# DMA_CMA 会被 DRM_ETNAVIV（defconfig GPU 驱动，MT7987 无此硬件）select，一并关闭：
# CONFIG_DRM_ETNAVIV is not set
# CONFIG_DMA_CMA is not set
# ---- 实验 C 追加对齐（优化轮，对照 frank-w Debian/Ubuntu defconfig）----
# NR_CPUS：defconfig 基座默认 512，对照组（原厂 OpenWrt / frank-w defconfig，R4 Mini 同 MT7987A）为 4。
# MT7987A 核数不超过 4，收紧为 4 消除 per-cpu 预分配与抢占点布局的剩余差量。
CONFIG_NR_CPUS=4
# MMC_BLOCK_MINORS：基座默认 32，对照组为 8；H5000M eMMC 仅 p1-p5 分区布局，
# 8 意味着每设备最多 7 分区，仍充足；严格对齐对照组消除次要差量。
CONFIG_MMC_BLOCK_MINORS=8
CONFIG_FRAME_POINTER=y
CONFIG_DMIID=n

# ---- 诊断 / 性能 ----
CONFIG_KALLSYMS=y
CONFIG_PRINTK_TIME=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_PERF_EVENTS=y
CONFIG_BPF_SYSCALL=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_PROC_KCORE=y
# ---- 挂死可诊断性（2026-10-09 实机实证后新增，勿删）----
# 背景：2026-10-09 实机串口显示系统在 t≈10s 发生**完全静默的内核级冻结**——
#   3 个 CPU（0/1/3）的 softirq 计数在 6 分钟内逐字不变（1096/1097、928/939、839/839），
#   CPU3 的 timer-softirq 冻结（内核自述 "Possible timer handling issue on cpu=3"），
#   `Sending NMI from CPU 2 to CPUs 0/1/3` 之后**拿不到任何 per-CPU 回栈**。
#   拿不到回栈的原因：未启用 CONFIG_ARM64_PSEUDO_NMI 时，arch_trigger_cpumask_backtrace()
#   走的是**普通 IPI**，而关中断自旋的 CPU 根本不取中断 → 只有 "Sending NMI" 一行，没有栈。
#   这直接导致只能靠猜，无法定位到函数。以下各项把「静默冻结」变成「带函数名的现场」。
# PSEUDO_NMI：让拉回栈的 IPI 变成 GICv3 优先级屏蔽的真 NMI，关中断的 CPU 也必须响应。
# 这是拿回 per-CPU 栈的唯一途径，也是 arm64 硬锁检测（HARDLOCKUP）的前置条件。
CONFIG_ARM64_PSEUDO_NMI=y
# 软/硬锁检测：CPU 在关中断路径里自旋超过阈值即打印现场（含回栈）。
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
# 任务级挂死检测：若有任务卡在块层（D 状态，如 resize2fs 等 eMMC 写完成）会点名任务与栈。
# （实测打印通道是通的：RCU stall 告警在冻结期间仍能正常输出，故该项在本故障下有效。）
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=30
# RCU stall 阈值从默认 21s 收紧到 10s，缩短现场出现的等待时间（HZ=100，1000 jiffies）。
CONFIG_RCU_CPU_STALL_TIMEOUT=10
CONFIG_BLK_DEV_LOOP=y
CONFIG_NFS_FS=m
CONFIG_NFS_V4=m
CONFIG_CIFS=m
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_INITRAMFS_SOURCE=""

# ---- 固件加载 ----
CONFIG_FW_LOADER_USER_HELPER=n
CONFIG_EXTRA_FIRMWARE=""

# ---- WAN 拨号（PPPoE）----
CONFIG_PPP=m
CONFIG_PPPOE=m
CONFIG_PPP_ASYNC=m
CONFIG_PPP_MPPE=m

# ---- 硬件流卸载（nftables flowtable / PPE offload）----
CONFIG_NF_FLOW_TABLE=m
CONFIG_NF_FLOW_TABLE_INET=m
CONFIG_NFT_FLOW_OFFLOAD=m

# ---- 2.5G 以太网 PHY（752 补丁已支持 MT7987，需编驱动）----
CONFIG_MEDIATEK_2P5GE_PHY=y
CONFIG_MTK_NET_PHYLIB=y

# ---- 5G 调制解调器（USB WWAN：MT5700M 等）----
CONFIG_WWAN=m
CONFIG_MTK_T7XX=m
CONFIG_USB_NET_QMI_WWAN=m
CONFIG_USB_NET_CDC_MBIM=m
CONFIG_USB_WDM=m
CONFIG_USB_ACM=m
CONFIG_USB_SERIAL_OPTION=m
