# Hiveton H5000M (MT7987A) Debian 13 内核配置增量片段
#
# 用法：make ARCH=arm64 defconfig
#       cat 本文件 >> .config
#       make ARCH=arm64 olddefconfig
#
# 说明：
# - 本片段在 arm64 defconfig 基础上做增量修改，缺省符号由 olddefconfig 补齐。
# - 符号名以 Linux 6.18.x + ImmortalWrt MT7987A 补丁为准；
#   构建脚本会在 olddefconfig 后核验关键符号，并输出报告。

# ---- SoC / 平台 ----
CONFIG_ARCH_MEDIATEK=y
CONFIG_PINCTRL_MT7987=y
CONFIG_COMMON_CLK_MT7987=y
CONFIG_COMMON_CLK_MT7987_ETHSYS=y
CONFIG_ARM_MEDIATEK_CPUFREQ=y
CONFIG_MTK_PMIC_WRAP=y

# ---- 网络（Ethernet / PHY / PCS）----
CONFIG_NET_MEDIATEK_SOC=y
CONFIG_MEDIATEK_GE_PHY=y
CONFIG_REALTEK_PHY=y
CONFIG_PCS_MTK_LYNXI=y
CONFIG_PHY_MTK_TPHY=y
CONFIG_PHY_MTK_DP=y
CONFIG_NETDEVICES=y
CONFIG_VETH=y
CONFIG_TUN=y
CONFIG_MACVLAN=y

# ---- Wi-Fi（mt76，含 MT7992）----
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN=y
CONFIG_MT76=y
CONFIG_MT76_LEDS=y
CONFIG_MT7921E=y
CONFIG_MT7925E=y
CONFIG_MT7996E=y
CONFIG_WIRELESS=y
CONFIG_WIRELESS_EXT=y

# ---- eMMC / 存储 ----
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MTK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_NLS_UTF8=y
CONFIG_BLK_DEV=y

# ---- PCIe ----
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_PCIE_MEDIATEK=y
CONFIG_PCIE_MEDIATEK_GEN3=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIEAER=y
CONFIG_PCIE_PME=y
CONFIG_PCI_MSI=y

# ---- USB ----
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_MTK=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_STORAGE=y
CONFIG_USB_SUPPORT=y

# ---- PWM / 风扇（pwm-fan：/sys/class/hwmon/*/pwm1 控制节点 + thermal cooling device）----
CONFIG_PWM=y
CONFIG_PWM_MEDIATEK=y
# 6.18 起符号由 PWM_FAN 改名 SENSORS_PWM_FAN（drivers/hwmon/Kconfig）
CONFIG_SENSORS_PWM_FAN=y

# ---- Thermal / 电源 ----
CONFIG_THERMAL=y
CONFIG_MTK_LVTS_THERMAL=y
CONFIG_MTK_THERMAL=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_IDLE=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# ---- 串口 / 时钟 / 杂项 ----
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_MTK=y
CONFIG_WATCHDOG=y
CONFIG_MTK_WDT=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_MT6397=y
CONFIG_GPIO_SYSFS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_NETDEV=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYS=y

# ---- NVMEM / 分区（eMMC factory 分区 → Wi-Fi EEPROM）----
CONFIG_NVMEM=y
CONFIG_NVMEM_LAYOUTS=y
CONFIG_NVMEM_LAYOUT_FIXED=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_OF_PARTITION=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y

# ---- Bridge / Netfilter / NAT（路由器必需）----
CONFIG_BRIDGE=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_FTP=y
CONFIG_NF_CONNTRACK_TFTP=y
CONFIG_NF_CONNTRACK_SIP=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_AMANDA=y
CONFIG_NF_NAT_FTP=y
CONFIG_NF_NAT_SIP=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_CT=y
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_LOG=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_QUEUE=y
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y

# ---- IPv4 / IPv6 / 路由 ----
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IPV6=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_INET=y
CONFIG_INET_DIAG=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_WIREGUARD=y

# ---- 安全 / systemd 基础 ----
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_AUTOFS_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_FW_LOADER=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_MISC=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_FUTEX=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SMP=y
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y
CONFIG_FRAME_POINTER=y
CONFIG_DMIID=n

# ---- 诊断 / 性能 ----
CONFIG_KALLSYMS=y
CONFIG_PRINTK_TIME=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_PERF_EVENTS=y
CONFIG_BPF_SYSCALL=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_PROC_KCORE=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_NFS_FS=m
CONFIG_NFS_V4=m
CONFIG_CIFS=m
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_INITRAMFS_SOURCE=""

# ---- 固件加载 ----
CONFIG_FW_LOADER_USER_HELPER=n
CONFIG_EXTRA_FIRMWARE=""

# ---- WAN 拨号（PPPoE）----
CONFIG_PPP=m
CONFIG_PPPOE=m
CONFIG_PPP_ASYNC=m
CONFIG_PPP_MPPE=m

# ---- 硬件流卸载（nftables flowtable / PPE offload）----
CONFIG_NF_FLOW_TABLE=m
CONFIG_NF_FLOW_TABLE_INET=m
CONFIG_NFT_FLOW_OFFLOAD=m

# ---- 2.5G 以太网 PHY（752 补丁已支持 MT7987，需编驱动）----
CONFIG_MEDIATEK_2P5GE_PHY=y
CONFIG_MTK_NET_PHYLIB=y

# ---- 5G 调制解调器（USB WWAN：MT5700M 等）----
CONFIG_WWAN=m
CONFIG_MTK_T7XX=m
CONFIG_USB_NET_QMI_WWAN=m
CONFIG_USB_NET_CDC_MBIM=m
CONFIG_USB_WDM=m
CONFIG_USB_ACM=m
CONFIG_USB_SERIAL_OPTION=m
